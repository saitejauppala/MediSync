PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/medisync
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE=30d
FRONTEND_URL=http://localhost:5173
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MediSync/1.0
NOMINATIM_CONTACT_EMAIL=replace-with-a-monitored-email@example.com
# Required only for the explicit production demo-user seed command. Use unique, random passwords.
# MEDISYNC_DEMO_PATIENT_PASSWORD=
# MEDISYNC_DEMO_HOSPITAL_ADMIN_PASSWORD=
# MEDISYNC_DEMO_PLATFORM_ADMIN_PASSWORD=
# MEDISYNC_ENABLE_DEMO_USER_SEED=true
